<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.witos.system.mapper.SysPlatformMapper">

    <resultMap type="com.witos.system.domain.SysPlatform" id="SysPlatformResult">
        <result property="id"         column="id"          />
        <result property="userId"     column="user_id"     />
        <result property="userName"    column="user_name"   />
        <result property="nickName"    column="nick_name"   />
        <result property="userPhone"   column="user_phone"  />
        <result property="password"    column="password"    />
        <result property="packageId"   column="package_id"  />
        <result property="status"      column="status"      />
        <result property="delFlag"     column="del_flag"    />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>

    <sql id="selectSysPlatformVo">
        select p.id, u.user_id, p.user_name, p.nick_name, p.user_phone, p.password, p.package_id, p.status, p.del_flag, p.create_by, p.create_time, p.update_by, p.update_time, p.remark
        from sys_platform p
        left join sys_user u on u.user_name = p.user_name and u.del_flag = '0'
    </sql>

    <select id="selectPlatformList" resultMap="SysPlatformResult">
        select p.id, u.user_id, p.user_name, p.nick_name, p.user_phone, p.password, p.package_id, p.status, p.del_flag, p.create_by, p.create_time, p.update_by, p.update_time, p.remark
        from sys_platform p
        left join sys_user u on u.user_name = p.user_name and u.del_flag = '0'
        <where>
            p.del_flag = '0'
            <if test="query.userName != null and query.userName != ''"> AND p.user_name like concat('%', #{query.userName}, '%')</if>
            <if test="query.userPhone != null and query.userPhone != ''"> AND p.user_phone = #{query.userPhone}</if>
            <if test="query.status != null and query.status != ''"> AND p.status = #{query.status}</if>
        </where>
    </select>

    <select id="selectPlatformById" parameterType="Long" resultMap="SysPlatformResult">
        <include refid="selectSysPlatformVo"/>
        where p.id = #{id} and p.del_flag = '0'
    </select>

    <select id="checkUserNameUnique" parameterType="String" resultMap="SysPlatformResult">
        select p.id, p.user_name from sys_platform p where p.user_name = #{userName} and p.del_flag = '0' limit 1
    </select>

    <insert id="insertPlatform" useGeneratedKeys="true" keyProperty="id">
        insert into sys_platform(
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="nickName != null and nickName != ''">nick_name,</if>
            <if test="userPhone != null and userPhone != ''">user_phone,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="packageId != null">package_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="nickName != null and nickName != ''">#{nickName},</if>
            <if test="userPhone != null and userPhone != ''">#{userPhone},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="packageId != null">#{packageId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updatePlatform">
        update sys_platform
        <set>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="nickName != null and nickName != ''">nick_name = #{nickName},</if>
            <if test="userPhone != null">user_phone = #{userPhone},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="packageId != null">package_id = #{packageId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deletePlatformByIds" parameterType="String">
        delete from sys_platform where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
